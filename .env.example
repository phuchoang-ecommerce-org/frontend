# Mock (Prism, default for local frontend work — run `npm run mock:api` first).
# Prism CLI does not honour the OpenAPI `servers` base path, so the mock's
# base URL carries no path suffix — endpoint paths in lib/api callers are
# always relative to this value (e.g. "/products/{productId}").
ECP_API_BASE_URL=http://localhost:4010

# Real backend (ecp-api running locally). The base URL includes the /api/v1
# prefix from the OpenAPI `servers` entry (Integration Contract §1.1) —
# the same relative endpoint paths resolve correctly against either value.
# ECP_API_BASE_URL=http://localhost:8080/api/v1
