{
  "name": "ecommerce-frontend-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint . && depcruise app components lib stores",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "codegen:api": "openapi-typescript ../docs/SA-docs/04-shared/OpenAPI/openapi.yaml -o lib/api/generated/openapi.d.ts",
    "codegen:api:check": "npm run codegen:api && git diff --exit-code -- lib/api/generated/openapi.d.ts",
    "mock:api": "prism mock ../docs/SA-docs/04-shared/OpenAPI/openapi.yaml -p 4010"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/wcag-contrast": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "wcag-contrast": "^3.0.0"
  }
}
