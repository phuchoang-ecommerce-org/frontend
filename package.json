{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-profile.mjs next dev",
    "build": "node scripts/with-profile.mjs next build",
    "build-webpack": "node scripts/with-profile.mjs next build --webpack",
    "start": "node scripts/with-profile.mjs next start",
    "lint": "node scripts/with-profile.mjs eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "boundaries": "depcruise src",
    "contract:generate": "openapi-typescript ../docs/SolutionArchitecture/04-shared/OpenAPI/openapi.yaml -o src/lib/api/types.ts",
    "contract:check": "node scripts/check-openapi-types.mjs",
    "mock:api": "prism mock ../docs/SolutionArchitecture/04-shared/OpenAPI/openapi.yaml --host 127.0.0.1 --port 4010",
    "check": "npm run contract:check && npm run typecheck && npm run lint && npm run boundaries && npm test",
    "test": "vitest run --project unit",
    "storybook": "node scripts/with-profile.mjs storybook dev -p 6006",
    "build-storybook": "node scripts/with-profile.mjs storybook build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@stoplight/prism-cli": "^5.16.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-storybook": "^10.6.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "latest",
    "shadcn": "^4.22.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^4"
  }
}
